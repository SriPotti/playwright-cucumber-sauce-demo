{
  "name": "playwright-cucumber-sauce-demo",
  "version": "1.0.0",
  "private": false,
  "description": "Public starter framework using Playwright, Cucumber BDD, TypeScript, POM, reports, and intentional failure examples.",
  "scripts": {
    "install:browsers": "npx playwright install",
    "tsc": "tsc",
    "start": "npx ts-node src/server/server.ts",
    "dev": "ts-node-dev src/server/server.ts",
    "lint": "ts-standard",
    "eslint": "npx eslint .",
    "pw:run": "npx playwright test",
    "bdd:all": "npx cucumber-js",
    "bdd:demo": "npx cucumber-js --tags '@Demo' --parallel 4",
    "bdd:smoke": "npx cucumber-js --tags '@Smoke' --parallel 5 --retry 3",
    "bdd:regression": "npx cucumber-js --tags '@Regression'",
    "bdd:test": "npx cucumber-js --tags '@demo'",
    "clean:allure": "del-cli ./test-results/allure-results",
    "allure-report": "npx allure serve ./test-results/allure-results -h localhost -p 63763",
    "allure-reportV3": "npx allure open ./test-results/allure-results --port 63763",
    "cucumber-report": "npx ts-node src/utils/multiple-cucumber/reporter.ts",
    "ci:send-report-email": "npx ts-node src/utils/ci/sendReportEmail.ts",
    "ci:publish-confluence": "npx ts-node src/utils/ci/publishConfluenceReport.ts",
    "show-trace": "npx playwright show-trace ./test-results/tracing/trace.zip",
    "encrypt:environment-urls": "ts-node ./src/utils/encrypt.ts src/data/env/EnvironmentUrls.json",
    "decrypt:environment-urls": "ts-node ./src/utils/decrypt.ts src/data/env/EnvironmentUrls.json.enc",
    "clear-cache": "ts-node ./src/utils/clearCacheUtils.ts",
    "zephyr:search": "npx ts-node src/utils/zephyrUtils.ts",
    "security:redaction": "npx ts-node scripts/security/assertLogRedaction.ts",
    "agent": "cd qa-locator-agent && OLLAMA_URL=http://127.0.0.1:11434 OLLAMA_MODEL=llama3:latest npm run analyze -- --report ../test-results/cucumber-results/cucumber-report.json && npx ts-node src/htmlReport.ts && open output/report.html",
    "clean": "rimraf reports test-results",
    "typecheck": "tsc --noEmit",
    "test": "npm run clean && cucumber-js --tags 'not @known_failure'",
    "test:smoke": "npm run clean && cucumber-js --tags '@smoke and not @known_failure'",
    "test:known-failures": "npm run clean && cucumber-js --tags '@known_failure'",
    "test:qafix": "npm run clean && node scripts/run-all-then-qafix.js",
    "qafix": "node scripts/qafix-from-traces.js",
    "qafix:trace": "node scripts/qafix-from-traces.js",
    "test:all": "npm run clean && cucumber-js",
    "report": "node scripts/generate-report.js",
    "posttest": "npm run report",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "multiple-cucumber-html-reporter": "^3.9.0",
    "prettier": "^3.5.0",
    "qafix": "file:../../qaFixAIAgent/qa-fix",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "engines": { "node": ">=20" },
  "license": "MIT"
}
 